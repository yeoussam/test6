    let currentQuestionIndex = 0;
    let attemptsLeft = 2; // 각 문제당 기회 2회
    let score = 0;
    let isAnswered = false;

    // Quiz 시작
    function startQuiz() {
      document.getElementById('start-screen').classList.add('hidden');
      document.getElementById('quiz-screen').classList.remove('hidden');
      document.getElementById('quiz-screen').classList.add('flex');
      currentQuestionIndex = 0;
      score = 0;
      loadQuestion();
    }

    // 문제 로드
    function loadQuestion() {
      const q = quizData[currentQuestionIndex];
      attemptsLeft = 2;
      isAnswered = false;

      // 헤더 및 진행바 업데이트
      document.getElementById('question-number').innerText = `문제 ${currentQuestionIndex + 1} / ${quizData.length}`;
      document.getElementById('attempt-badge').innerText = `기회: 2회 남음`;
      document.getElementById('attempt-badge').className = "text-xs font-semibold px-2.5 py-1 bg-slate-100 text-slate-600 rounded-lg";
      
      const progressPercent = ((currentQuestionIndex + 1) / quizData.length) * 100;
      document.getElementById('progress-bar').style.width = `${progressPercent}%`;

      // 공통 지문 처리
      const passageBox = document.getElementById('passage-box');
      if (q.passage) {
        document.getElementById('passage-title').innerText = q.passageTitle || "[공통 지문] 다음 글을 읽고 물음에 답하시오.";
        document.getElementById('passage-text').innerText = q.passage;
        passageBox.classList.remove('hidden');
      } else {
        passageBox.classList.add('hidden');
      }

      // 문제 텍스트
      document.getElementById('question-text').innerText = q.question;

      // 보기 생성
      const container = document.getElementById('options-container');
      container.innerHTML = '';

      q.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.id = `option-btn-${idx}`;
        btn.className = "w-full text-left p-3.5 sm:p-4 rounded-xl border border-slate-200 bg-white hover:bg-indigo-50/50 hover:border-indigo-300 font-medium text-slate-700 transition-all flex items-center justify-between text-xs sm:text-sm group";
        btn.onclick = () => selectOption(idx);
        
        btn.innerHTML = `
          <div class="flex items-center gap-3 pr-2">
            <span class="w-6 h-6 rounded-lg bg-slate-100 group-hover:bg-indigo-100 text-slate-500 group-hover:text-indigo-600 font-bold text-xs flex items-center justify-center shrink-0 transition-colors">
              ${idx + 1}
            </span>
            <span class="leading-relaxed">${opt}</span>
          </div>
          <i class="fa-regular fa-circle text-slate-300 group-hover:text-indigo-400 shrink-0"></i>
        `;
        container.appendChild(btn);
      });

      // 피드백 박스 및 다음 버튼 초기화
      document.getElementById('feedback-box').classList.add('hidden');
      document.getElementById('next-btn').classList.add('hidden');
      
      // 버튼 텍스트 설정 (마지막 문제 체크)
      const nextBtnText = document.getElementById('next-btn-text');
      if (currentQuestionIndex === quizData.length - 1) {
        nextBtnText.innerText = "최종 결과 보기";
      } else {
        nextBtnText.innerText = "다음 문제로";
      }
    }

    // 답안 선택 시 동작
    function selectOption(index) {
      if (isAnswered) return;

      const q = quizData[currentQuestionIndex];
      const selectedBtn = document.getElementById(`option-btn-${index}`);
      const feedbackBox = document.getElementById('feedback-box');
      const feedbackIcon = document.getElementById('feedback-icon');
      const feedbackTitle = document.getElementById('feedback-title');
      const feedbackDetail = document.getElementById('feedback-detail');

      // 정답 선택
      if (index === q.answer) {
        isAnswered = true;
        // 문제당 4점 만점 (첫 번째 시도 정답: 4점, 두 번째 시도 정답: 2점)
        score += (attemptsLeft === 2) ? 4 : 2;

        selectedBtn.className = "w-full text-left p-3.5 sm:p-4 rounded-xl border-2 border-emerald-500 bg-emerald-50 font-bold text-emerald-900 flex items-center justify-between text-xs sm:text-sm shadow-sm";
        selectedBtn.querySelector('i').className = "fa-solid fa-circle-check text-emerald-600 text-base sm:text-lg";

        feedbackBox.className = "p-4 rounded-2xl mb-4 text-xs sm:text-sm leading-relaxed flex items-start gap-3 bg-emerald-50 border border-emerald-200 text-emerald-900";
        feedbackIcon.className = "fa-solid fa-circle-check text-emerald-600 text-lg sm:text-xl mt-0.5";
        feedbackTitle.innerText = "정답입니다! 잘했습니다! 🎉";
        feedbackDetail.innerText = q.explanation;
        feedbackBox.classList.remove('hidden');

        disableAllOptions();
        document.getElementById('next-btn').classList.remove('hidden');

      } else {
        // 오답 선택
        attemptsLeft--;

        if (attemptsLeft === 1) {
          // 1차 오답 -> 한 번 더 기회 제공
          selectedBtn.className = "w-full text-left p-3.5 sm:p-4 rounded-xl border border-rose-300 bg-rose-50 text-rose-700 opacity-60 cursor-not-allowed flex items-center justify-between text-xs sm:text-sm";
          selectedBtn.querySelector('i').className = "fa-solid fa-circle-xmark text-rose-400";
          selectedBtn.disabled = true;

          document.getElementById('attempt-badge').innerText = `기회: 1회 남음`;
          document.getElementById('attempt-badge').className = "text-xs font-semibold px-2.5 py-1 bg-amber-100 text-amber-800 rounded-lg animate-pulse";

          feedbackBox.className = "p-4 rounded-2xl mb-4 text-xs sm:text-sm leading-relaxed flex items-start gap-3 bg-amber-50 border border-amber-200 text-amber-900";
          feedbackIcon.className = "fa-solid fa-triangle-exclamation text-amber-600 text-lg sm:text-xl mt-0.5";
          feedbackTitle.innerText = "아쉽네요! 다시 한번 생각해볼까요? 🤔";
          feedbackDetail.innerText = "선택한 답은 정답이 아닙니다. 한 번 더 기회가 있으니 지문과 문제를 천천히 읽고 다른 답을 선택해보세요!";
          feedbackBox.classList.remove('hidden');

        } else {
          // 2차 오답 -> 정답 공개 후 이동
          isAnswered = true;
          selectedBtn.className = "w-full text-left p-3.5 sm:p-4 rounded-xl border border-rose-300 bg-rose-50 text-rose-700 opacity-60 flex items-center justify-between text-xs sm:text-sm";
          selectedBtn.querySelector('i').className = "fa-solid fa-circle-xmark text-rose-400";

          // 정답 보기 강조 표시
          const correctBtn = document.getElementById(`option-btn-${q.answer}`);
          correctBtn.className = "w-full text-left p-3.5 sm:p-4 rounded-xl border-2 border-emerald-500 bg-emerald-50 font-bold text-emerald-900 flex items-center justify-between text-xs sm:text-sm shadow-sm";
          correctBtn.querySelector('i').className = "fa-solid fa-circle-check text-emerald-600 text-base sm:text-lg";

          document.getElementById('attempt-badge').innerText = `기회 소진`;
          document.getElementById('attempt-badge').className = "text-xs font-semibold px-2.5 py-1 bg-rose-100 text-rose-700 rounded-lg";

          feedbackBox.className = "p-4 rounded-2xl mb-4 text-xs sm:text-sm leading-relaxed flex items-start gap-3 bg-rose-50 border border-rose-200 text-rose-900";
          feedbackIcon.className = "fa-solid fa-circle-info text-rose-600 text-lg sm:text-xl mt-0.5";
          feedbackTitle.innerText = `정답은 ${q.answer + 1}번입니다.`;
          feedbackDetail.innerText = q.explanation;
          feedbackBox.classList.remove('hidden');

          disableAllOptions();
          document.getElementById('next-btn').classList.remove('hidden');
        }
      }
    }

    // 모든 보기 선택 비활성화
    function disableAllOptions() {
      const q = quizData[currentQuestionIndex];
      q.options.forEach((_, idx) => {
        const btn = document.getElementById(`option-btn-${idx}`);
        btn.disabled = true;
      });
    }

    // 다음 문제 이동
    function nextQuestion() {
      currentQuestionIndex++;
      if (currentQuestionIndex < quizData.length) {
        loadQuestion();
      } else {
        showResults();
      }
    }

    // 결과 화면
    function showResults() {
      document.getElementById('quiz-screen').classList.add('hidden');
      document.getElementById('quiz-screen').classList.remove('flex');
      document.getElementById('result-screen').classList.remove('hidden');
      document.getElementById('result-screen').classList.add('flex');

      document.getElementById('final-score').innerText = `${score}점`;
      document.getElementById('score-summary').innerText = `총 25문제 완료 (100점 만점 중 ${score}점 획득)`;
    }

    // 다시 시작
    function restartQuiz() {
      document.getElementById('result-screen').classList.add('hidden');
      document.getElementById('result-screen').classList.remove('flex');
      startQuiz();
    }
  </script>
</body>
